# ---------- Generated output ----------
# Every run overwrites these. Regenerate with:  python run.py
output/

# Keep the folder itself in the repo so the code has somewhere to write.
!output/.gitkeep

# ---------- Manual research data: TRACKED ON PURPOSE ----------
# fundamentals_override.csv holds hours of hand-entered figures from annual
# reports. Losing it means redoing that work, and it is part of your
# methodology's audit trail. It stays in version control.
!data/fundamentals_override.csv
!data/companies.csv

