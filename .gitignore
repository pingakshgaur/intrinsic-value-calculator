# ---------------------------------------------------------------------------
# INTVAL-Calc
# ---------------------------------------------------------------------------

# --- Generated output -------------------------------------------------------
# Every run rewrites this folder: the report + xlsx, the numeric twin, five
# metric tables, the HTML index, run_log.txt, and twelve HD PNGs under
# charts/. The PNGs are a few MB per run and git stores each version in full,
# so committing them makes the repo grow without bound.
output/*

# --- Caches -----------------------------------------------------------------
# Resolved tickers from Yahoo search. Machine-specific, unverified, and it
# silently outranks nothing now that MANUAL takes priority - but a stale entry
# for a name absent from MANUAL will still be reused. Regenerate it rather
# than sharing it.
.cache/

__pycache__/
*.py[cod]
*$py.class

# --- Secrets ----------------------------------------------------------------
# API keys for the market intelligence agents. .env.example is the template.
.env
.env.*
!.env.example

# --- Web UI -----------------------------------------------------------------
# web/dist IS tracked on purpose: 'python run.py --web' then works on a fresh
# clone without Node installed. Rebuild it with 'npm run build' after editing
# web/src.
web/node_modules/
*.tsbuildinfo

# --- Agent state checked out by the cloud workflow --------------------------
intel_state/

# --- Environments -----------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Editors ----------------------------------------------------------------
# .vscode/settings.json IS tracked - it carries the extraPaths that make the
# flat imports resolve, so a fresh clone needs it. Ignore everything else.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Scratch ----------------------------------------------------------------
*.log
*.tmp
scratch/
# backup written when settings are saved from the web app
agent_settings.yaml.bak

# --- Live market & learning state (watchlist, minute-bar store, alerts) ------
data/live/
