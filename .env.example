# Copy this file to .env (same folder) and fill in whichever keys you have.
# .env is git-ignored. In the cloud, set these as GitHub repository secrets
# instead - never commit real keys.

# Groq        https://console.groq.com/keys
GROQ_API_KEY=
# Google AI   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA NIM  https://build.nvidia.com  (profile -> API keys)
NVIDIA_API_KEY=

# Optional Telegram alerts (also set alerts.telegram: true in agent_settings.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional data providers (Configuration -> Data sources). Free keys; each one
# only fills what Yahoo Finance and Screener.in do not have.
# Financial Modeling Prep  https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# EODHD                    https://eodhd.com
EODHD_API_KEY=
# Alpha Vantage            https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
